# Xv6 Agent Environment Variables

# Required - Choose one LLM provider
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# Optional settings
XV6_AGENT_DEBUG=false
XV6_AGENT_CONFIG_PATH=.xv6_agent/config.yaml
XV6_AGENT_LOG_LEVEL=INFO

# Advanced options
XV6_FORCE_CPU_EMBEDDING=false
XV6_DISABLE_TELEMETRY=true
XV6_LOCAL_ONLY_MODE=false
